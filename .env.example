# Exemple de configuration — aucun secret ici. Copier en .env et adapter.

# Mode de publication : preview (prévisualisation protégée, catalogue interne visible, tout en noindex)
# ou production (seules les prestations et tarifs approuvés sont émis). La production échoue
# tant que les mentions légales de src/data/site.ts ne sont pas renseignées.
RESTUP_MODE=preview

# --- Formulaire (navigateur) -------------------------------------------------------------
# Adresse qui reçoit les demandes. Vide = le formulaire affiche « temporairement indisponible »
# (jamais de faux succès).
#   local    : http://localhost:8787/api/leads   avec PUBLIC_LEADS_ADAPTER=http
#   Supabase : https://<projet>.supabase.co/rest/v1/rpc/submit_lead   avec PUBLIC_LEADS_ADAPTER=supabase
PUBLIC_LEADS_ENDPOINT=
PUBLIC_LEADS_ADAPTER=http
# Clé publique « anon » Supabase (publique par nature, protégée par RLS) — seulement avec l'adaptateur supabase.
PUBLIC_SUPABASE_ANON_KEY=

# --- Serveur local des demandes (npm run leads:server) -----------------------------------
LEADS_PORT=8787
LEADS_DB=.data/leads.sqlite
LEADS_OUTBOX=.data/outbox
LEADS_ALLOWED_ORIGINS=http://localhost:4321
LEADS_RATE_MAX=5
LEADS_RATE_WINDOW_MS=600000
NOTIFY_INTERVAL_MS=2000
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_INTERNAL_TO=equipe@restup.test
NOTIFY_FROM=RESTUP <no-reply@restup.test>
# Forcer un échec d'envoi pour tester la reprise : LEADS_SIMULATE_FAILURE=1
