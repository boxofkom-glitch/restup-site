---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
---

<style is:inline>
  :root,
  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-archivo);

    /* Charte RESTUP (direction artistique validée, valeurs provisoires remplaçables) */
    --ru-brand-950: #180525;
    --ru-brand-900: #2b0746;
    --ru-brand-800: #420969;
    --ru-glow: #8700c9;
    --ru-yellow: #ffe000;
    --ru-cyan: #28cff2;
    --ru-white: #ffffff;
    --ru-text-soft: #e7ddee;
    --ru-ink: #240638;
    --ru-surface: #f7f3fa;
    --ru-muted-light: #5c5368;
    --ru-border-light: #d8cfe4;
    --ru-input-border: #72647f;
    --ru-error: #a32244;
    --ru-error-dark: #ff9db5;

    /* Palette claire premium : fond jaune, sections bleu ciel, encarts violets */
    --ru-paper: #fff8dc;
    --ru-sun: #ffe45e;
    --ru-sky: #dff3ff;
    --ru-sky-strong: #8fd6ff;
    --ru-violet: #5b21b6;
    --ru-violet-deep: #2e0a5c;
    --ru-night: #1a0833;
    --ru-text: #22113d;
    --ru-text-muted: #54456b;

    --aw-color-primary: rgb(255 224 0);
    --aw-color-secondary: rgb(242 200 0);
    --aw-color-accent: rgb(40 207 242);
    --aw-color-link: rgb(91 33 182);

    --aw-color-text-heading: rgb(34 17 61);
    --aw-color-text-default: rgb(34 17 61);
    --aw-color-text-muted: rgb(84 69 107);
    --aw-color-bg-page: rgb(255 248 220);

    --aw-color-bg-page-dark: rgb(255 248 220);

    ::selection {
      background-color: rgb(91 33 182);
      color: #fff;
    }
  }
</style>
