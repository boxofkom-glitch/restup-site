---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(109 40 217);
    --aw-color-secondary: rgb(91 33 182);
    --aw-color-accent: rgb(109 40 217);

    --aw-color-text-heading: rgb(17 17 24);
    --aw-color-text-default: rgb(31 31 40);
    --aw-color-text-muted: rgb(31 31 40 / 68%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(17 12 28);

    ::selection {
      background-color: rgb(237 233 254);
    }
  }

  /* Site sans animation */
  *,
  *::before,
  *::after {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }
</style>
