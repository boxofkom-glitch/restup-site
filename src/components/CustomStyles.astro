---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
---

<style is:inline>
  :root,
  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(139 69 245);
    --aw-color-secondary: rgb(109 40 217);
    --aw-color-accent: rgb(179 123 255);
    --aw-color-link: rgb(179 123 255);

    --aw-color-text-heading: rgb(250 248 255);
    --aw-color-text-default: rgb(226 222 236);
    --aw-color-text-muted: rgb(226 222 236 / 62%);
    --aw-color-bg-page: rgb(9 6 16);

    --aw-color-bg-page-dark: rgb(9 6 16);

    ::selection {
      background-color: rgb(139 69 245 / 0.45);
      color: #fff;
    }
  }
</style>
