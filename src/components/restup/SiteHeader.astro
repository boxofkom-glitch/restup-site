---
// En-tête RESTUP sur une seule ligne : les dix divisions sont regroupées sous « Expertises »
// (panneau sur ordinateur, liste dans le menu mobile), avec des libellés courts.
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import { divisions } from '~/lib/catalogue';
import { DIVISION_ORDER, DIVISION_LABELS } from '~/data/site';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const ordered = DIVISION_ORDER.map((slug) => ({
  ...divisions.find((d) => d.slug === slug)!,
  ...DIVISION_LABELS[slug],
}));
const links = [
  { text: 'La Carte', href: '/tarifs' },
  { text: 'Offres', href: '/offres' },
  { text: 'À propos', href: '/a-propos' },
  { text: 'Contact', href: '/contact' },
];
const current = (href: string) => (path === href ? 'page' : undefined);
const inExpertises = path.startsWith('/expertises');
---

<header
  class="sticky top-0 z-40 border-b border-[rgb(34_17_61/0.08)] bg-[rgb(255_248_220/0.82)] backdrop-blur-xl backdrop-saturate-150"
>
  <div class="ru-container flex items-center justify-between gap-4 h-[76px]">
    <a href="/" class="shrink-0" aria-label="RESTUP, accueil"><Logo /></a>

    <nav aria-label="Navigation principale" class="hidden lg:flex items-center gap-1">
      <div class="relative" data-disclosure>
        <button
          type="button"
          class:list={[
            'flex items-center gap-1 px-3 py-2 rounded-lg font-semibold hover:bg-[rgb(91_33_182/0.08)]',
            inExpertises && 'text-[var(--ru-violet)]',
          ]}
          aria-expanded="false"
          aria-controls="ru-expertises-panel"
        >
          Expertises <Icon name="tabler:chevron-down" class="w-4 h-4" aria-hidden="true" />
        </button>
        <div
          id="ru-expertises-panel"
          hidden
          class="absolute left-1/2 -translate-x-1/2 top-full mt-3 w-[620px] rounded-2xl border border-[rgb(34_17_61/0.1)] bg-[#fffdf6] p-3 shadow-[0_40px_80px_-40px_rgb(46_10_92/0.55)]"
        >
          <ul class="grid grid-cols-2 gap-1">
            {
              ordered.map((d) => (
                <li>
                  <a
                    href={d.path}
                    aria-current={current(d.path)}
                    class="block rounded-xl px-3 py-2.5 hover:bg-[rgb(91_33_182/0.08)] aria-[current=page]:bg-[rgb(91_33_182/0.08)]"
                  >
                    <span class="block font-bold text-[var(--ru-text)]">{d.label}</span>
                    <span class="block text-sm ru-soft">{d.hint}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <a
            href="/expertises"
            class="mt-2 flex items-center justify-between rounded-xl bg-[var(--ru-violet)] px-4 py-3 font-bold text-white hover:bg-[var(--ru-violet-deep)]"
          >
            Toutes les expertises <Icon name="tabler:arrow-right" class="w-5 h-5" aria-hidden="true" />
          </a>
        </div>
      </div>
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={current(l.href)}
            class="px-3 py-2 rounded-lg font-semibold hover:bg-[rgb(91_33_182/0.08)] aria-[current=page]:text-[var(--ru-violet)]"
          >
            {l.text}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href="/diagnostic" class="ru-btn ru-btn-primary hidden sm:inline-flex">Demander un diagnostic</a>
      <button
        type="button"
        class="lg:hidden grid place-items-center w-12 h-12 rounded-xl border border-[rgb(34_17_61/0.25)]"
        aria-expanded="false"
        aria-controls="ru-mobile-menu"
        data-mobile-toggle
      >
        <Icon name="tabler:menu-2" class="w-6 h-6" aria-hidden="true" data-open-icon />
        <Icon name="tabler:x" class="w-6 h-6 hidden" aria-hidden="true" data-close-icon />
        <span class="sr-only" data-label>Ouvrir le menu</span>
      </button>
    </div>
  </div>

  <!-- Menu mobile et tablette -->
  <div
    id="ru-mobile-menu"
    hidden
    class="lg:hidden border-t border-[rgb(34_17_61/0.08)] bg-[#fffdf6] max-h-[calc(100dvh-76px)] overflow-y-auto"
  >
    <nav aria-label="Menu" class="ru-container py-4">
      <p class="ru-eyebrow mb-2">Expertises</p>
      <ul class="grid sm:grid-cols-2 gap-1">
        {
          ordered.map((d) => (
            <li>
              <a
                href={d.path}
                aria-current={current(d.path)}
                class="block rounded-lg px-3 py-3 font-semibold hover:bg-[rgb(91_33_182/0.08)] aria-[current=page]:text-[var(--ru-violet)]"
              >
                {d.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/expertises" class="ru-link mt-2 inline-block px-3 py-2">Toutes les expertises</a>
      <ul class="mt-4 border-t border-[rgb(34_17_61/0.1)] pt-4 space-y-1">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={current(l.href)}
                class="block rounded-lg px-3 py-3 font-semibold hover:bg-[rgb(91_33_182/0.08)]"
              >
                {l.text}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/diagnostic" class="ru-btn ru-btn-primary w-full mt-4">Demander un diagnostic</a>
    </nav>
  </div>
</header>

<script>
  // Panneaux ouvrables au clic et au clavier, fermeture par Échap avec retour du focus.
  function wire(button: HTMLButtonElement, panel: HTMLElement, onToggle?: (open: boolean) => void) {
    const set = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      onToggle?.(open);
    };
    button.addEventListener('click', () => set(button.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        set(false);
        button.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!panel.hidden && !panel.contains(e.target as Node) && !button.contains(e.target as Node)) set(false);
    });
  }

  const disclosure = document.querySelector<HTMLElement>('[data-disclosure]');
  if (disclosure) {
    wire(disclosure.querySelector('button')!, disclosure.querySelector<HTMLElement>('#ru-expertises-panel')!);
  }

  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const menu = document.getElementById('ru-mobile-menu');
  if (toggle && menu) {
    wire(toggle, menu, (open) => {
      toggle.querySelector('[data-open-icon]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-close-icon]')?.classList.toggle('hidden', !open);
      toggle.querySelector('[data-label]')!.textContent = open ? 'Fermer le menu' : 'Ouvrir le menu';
    });
  }
</script>
