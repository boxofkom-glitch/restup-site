---
// En-tête RESTUP : ligne institutionnelle + ligne des dix divisions sur grand écran,
// panneau « Divisions » sur largeur intermédiaire, menu complet sur mobile.
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import { divisions } from '~/lib/catalogue';
import { DIVISION_ORDER } from '~/data/site';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const ordered = DIVISION_ORDER.map((slug) => divisions.find((d) => d.slug === slug)!);
const links = [
  { text: 'Offres', href: '/offres' },
  { text: 'À propos', href: '/a-propos' },
  { text: 'Contact', href: '/contact' },
];
const current = (href: string) => (path === href ? 'page' : undefined);
const inDivisions = path.startsWith('/expertises');
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-[rgb(24_5_37/0.96)] backdrop-blur">
  <div class="ru-container flex items-center justify-between gap-4 h-[72px]">
    <a href="/" class="shrink-0" aria-label="RESTUP, accueil"><Logo /></a>

    <nav aria-label="Navigation principale" class="hidden lg:flex items-center gap-1">
      <div class="relative xl:hidden" data-disclosure>
        <button
          type="button"
          class:list={[
            'flex items-center gap-1 px-3 py-2 rounded-lg font-semibold hover:bg-white/10',
            inDivisions && 'text-[var(--ru-yellow)]',
          ]}
          aria-expanded="false"
          aria-controls="ru-divisions-panel"
        >
          Divisions <Icon name="tabler:chevron-down" class="w-4 h-4" aria-hidden="true" />
        </button>
        <div
          id="ru-divisions-panel"
          hidden
          class="absolute left-0 top-full mt-2 w-[460px] rounded-2xl border border-white/15 bg-[var(--ru-brand-900)] p-4 shadow-2xl"
        >
          <ul class="grid grid-cols-2 gap-1">
            {
              ordered.map((d) => (
                <li>
                  <a
                    href={d.path}
                    aria-current={current(d.path)}
                    class="block rounded-lg px-3 py-2 font-semibold hover:bg-white/10 aria-[current=page]:bg-[var(--ru-yellow)] aria-[current=page]:text-[var(--ru-ink)]"
                  >
                    {d.name}
                  </a>
                </li>
              ))
            }
          </ul>
          <a href="/expertises" class="ru-link mt-3 inline-block px-3">Toutes les expertises</a>
        </div>
      </div>
      <a
        href="/expertises"
        aria-current={current('/expertises')}
        class="hidden xl:block px-3 py-2 rounded-lg font-semibold hover:bg-white/10 aria-[current=page]:text-[var(--ru-yellow)]"
        >Expertises</a
      >
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={current(l.href)}
            class="px-3 py-2 rounded-lg font-semibold hover:bg-white/10 aria-[current=page]:text-[var(--ru-yellow)]"
          >
            {l.text}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href="/diagnostic" class="ru-btn ru-btn-primary hidden sm:inline-flex">Demander un diagnostic</a>
      <button
        type="button"
        class="lg:hidden grid place-items-center w-12 h-12 rounded-xl border border-white/25"
        aria-expanded="false"
        aria-controls="ru-mobile-menu"
        data-mobile-toggle
      >
        <Icon name="tabler:menu-2" class="w-6 h-6" aria-hidden="true" data-open-icon />
        <Icon name="tabler:x" class="w-6 h-6 hidden" aria-hidden="true" data-close-icon />
        <span class="sr-only" data-label>Ouvrir le menu</span>
      </button>
    </div>
  </div>

  <!-- Ligne des dix divisions, toujours visible sur grand écran -->
  <nav aria-label="Divisions RESTUP" class="hidden xl:block border-t border-white/10">
    <ul class="ru-container flex flex-wrap items-center gap-x-1 gap-y-1 py-2 text-[0.9375rem]">
      {
        ordered.map((d) => (
          <li>
            <a
              href={d.path}
              aria-current={current(d.path)}
              class="block rounded-lg px-2.5 py-1.5 font-bold italic tracking-wide hover:bg-white/10 aria-[current=page]:bg-[var(--ru-yellow)] aria-[current=page]:text-[var(--ru-ink)]"
            >
              {d.name}
            </a>
          </li>
        ))
      }
      <li class="ml-auto">
        <a href="/expertises" class="ru-link text-sm">Toutes les expertises</a>
      </li>
    </ul>
  </nav>

  <!-- Menu mobile et tablette -->
  <div
    id="ru-mobile-menu"
    hidden
    class="lg:hidden border-t border-white/10 bg-[var(--ru-brand-900)] max-h-[calc(100dvh-72px)] overflow-y-auto"
  >
    <nav aria-label="Menu" class="ru-container py-4">
      <p class="ru-eyebrow mb-2">Divisions</p>
      <ul class="grid sm:grid-cols-2 gap-1">
        {
          ordered.map((d) => (
            <li>
              <a
                href={d.path}
                aria-current={current(d.path)}
                class="block rounded-lg px-3 py-3 font-bold italic hover:bg-white/10 aria-[current=page]:bg-[var(--ru-yellow)] aria-[current=page]:text-[var(--ru-ink)]"
              >
                {d.name}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/expertises" class="ru-link mt-2 inline-block px-3 py-2">Toutes les expertises</a>
      <ul class="mt-4 border-t border-white/10 pt-4 space-y-1">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={current(l.href)}
                class="block rounded-lg px-3 py-3 font-semibold hover:bg-white/10"
              >
                {l.text}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/diagnostic" class="ru-btn ru-btn-primary w-full mt-4">Demander un diagnostic</a>
    </nav>
  </div>
</header>

<script>
  // Panneaux ouvrables au clic et au clavier, fermeture par Échap avec retour du focus.
  function wire(button: HTMLButtonElement, panel: HTMLElement, onToggle?: (open: boolean) => void) {
    const set = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      onToggle?.(open);
    };
    button.addEventListener('click', () => set(button.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        set(false);
        button.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!panel.hidden && !panel.contains(e.target as Node) && !button.contains(e.target as Node)) set(false);
    });
  }

  const disclosure = document.querySelector<HTMLElement>('[data-disclosure]');
  if (disclosure) {
    wire(disclosure.querySelector('button')!, disclosure.querySelector<HTMLElement>('#ru-divisions-panel')!);
  }

  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const menu = document.getElementById('ru-mobile-menu');
  if (toggle && menu) {
    wire(toggle, menu, (open) => {
      toggle.querySelector('[data-open-icon]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-close-icon]')?.classList.toggle('hidden', !open);
      toggle.querySelector('[data-label]')!.textContent = open ? 'Fermer le menu' : 'Ouvrir le menu';
    });
  }
</script>
