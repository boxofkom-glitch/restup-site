---
export interface Props {
  title: string;
  text?: string;
  cta: string;
  href: string;
}
const { title, text, cta, href } = Astro.props;
---

<section class="ru-section ru-deep">
  <div class="ru-container">
    <div
      class="ru-on-violet ru-corners ru-corners-sm relative isolate overflow-hidden rounded-[32px] bg-gradient-to-br from-[#5b21b6] via-[#3b0f80] to-[#2e0a5c] px-6 pt-20 pb-16 md:px-14 text-center text-white shadow-[0_50px_100px_-50px_rgb(46_10_92/0.9)]"
    >
      <div class="ru-glow left-1/2 -translate-x-1/2 -top-1/2" aria-hidden="true"></div>
      <h2 class="ru-display ru-h2">{title}</h2>
      {text && <p class="ru-lead mx-auto mt-4">{text}</p>}
      <a href={href} class="ru-btn ru-btn-primary mt-8 !min-h-[56px] !px-8 text-lg">{cta}</a>
    </div>
  </div>
</section>
