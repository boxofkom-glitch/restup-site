---
// Lien en forme de bouton scintillant (Magic UI « Shimmer Button »)
import { Icon } from 'astro-icon/components';

export interface Props {
  href: string;
  icon?: string;
  class?: string;
}

const { href, icon = 'tabler:arrow-right', class: className = '' } = Astro.props;
---

<a href={href} class:list={['mu-shimmer', className]}>
  <span class="mu-shimmer__spark" aria-hidden="true"><span></span></span>
  <slot />
  {icon && <Icon name={icon} class="w-5 h-5" />}
  <span class="mu-shimmer__backdrop" aria-hidden="true"></span>
</a>
