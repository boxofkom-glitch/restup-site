---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Demande reçue · RESTUP',
  ignoreTitleTemplate: true,
  description: 'Confirmation de réception de votre demande.',
  robots: { index: false, follow: false },
};
---

<Layout metadata={metadata}>
  <section class="ru-corners ru-dark">
    <div class="ru-container py-24 md:py-32 max-w-3xl">
      <h1 class="ru-display ru-h1">Votre demande a bien été reçue</h1>
      <p class="ru-lead mt-5">Nous allons examiner les éléments transmis et vous recontacter à l’adresse indiquée.</p>
      <a href="/" class="ru-btn ru-btn-primary mt-8">Revenir à l’accueil</a>
    </div>
  </section>
</Layout>
