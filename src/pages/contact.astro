---
import Layout from '~/layouts/PageLayout.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

import { CONTACT } from '~/contact';

const email = CONTACT.email;

const metadata = {
  title: 'Demander mon audit gratuit',
  description:
    'Demande ton audit stratégique gratuit RESTUP : un message suffit, réponse sous 48 h, sans engagement. Coaching de pilotage pour restaurateurs.',
};
---

<Layout metadata={metadata}>
  <section class="relative overflow-hidden">
    <div class="mu-glow" aria-hidden="true"></div>
    <div class="mu-dots" aria-hidden="true"></div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 pt-16 md:pt-24 pb-4 text-center">
      <p class="mu-rise text-sm font-semibold uppercase tracking-widest text-accent">Audit gratuit</p>
      <h1 class="mu-rise mt-4 text-4xl md:text-6xl font-extrabold tracking-tight text-heading" style="--delay:.08s">
        Prêt à reprendre la main <span class="mu-gradient-text">sur ton restaurant ?</span>
      </h1>
      <p class="mu-rise mt-5 text-lg text-muted" style="--delay:.16s">
        Un message suffit. On revient vers toi sous 48 h pour caler ton audit stratégique gratuit, sans engagement.
      </p>
    </div>
  </section>

  <ContactUs
    id="form"
    title="Parle-nous de ton restaurant"
    inputs={[
      { type: 'text', name: 'name', label: 'Nom', autocomplete: 'name' },
      { type: 'text', name: 'restaurant', label: 'Restaurant et ville', autocomplete: 'organization' },
      { type: 'email', name: 'email', label: 'Email', autocomplete: 'email' },
    ]}
    textarea={{ label: 'Ton message', placeholder: 'Ce qui te bloque aujourd’hui, en quelques lignes.' }}
    button="Demander mon audit gratuit"
    description={`Ta messagerie s'ouvre avec le message pré-rempli. Tu peux aussi écrire à ${email} ou appeler ${CONTACT.name} au ${CONTACT.phone}.`}
  />

  <Features2
    columns={2}
    items={[
      { title: 'Audit 100 % gratuit', description: 'Un premier échange pour comprendre ton établissement et tes objectifs.', icon: 'tabler:gift' },
      { title: `${CONTACT.name}, RESTUP`, description: `Ton interlocuteur, basé à ${CONTACT.city}.`, icon: 'tabler:map-pin' },
      { title: 'Téléphone', description: CONTACT.phone, icon: 'tabler:phone', href: `tel:${CONTACT.phoneIntl}` },
      { title: 'Email', description: email, icon: 'tabler:mail', href: `mailto:${email}` },
    ]}
  />
</Layout>

<script define:vars={{ email }}>
  const form = document.querySelector('#form form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = (n) => (form.elements.namedItem(n)?.value || '').trim();
    const body = `Nom : ${v('name')}\nRestaurant : ${v('restaurant')}\nEmail : ${v('email')}\n\n${v('message')}`;
    location.href = `mailto:${email}?subject=${encodeURIComponent('Demande d’audit gratuit')}&body=${encodeURIComponent(body)}`;
  });
</script>
