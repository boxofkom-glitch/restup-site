---
import Layout from '~/layouts/PageLayout.astro';
import LeadForm from '~/components/restup/LeadForm.astro';

const metadata = {
  title: 'Contacter RESTUP',
  ignoreTitleTemplate: true,
  description: 'Posez une question sur les expertises RESTUP ou présentez une proposition de partenariat.',
};
---

<Layout metadata={metadata}>
  <section class="ru-corners ru-dark">
    <div class="ru-container pt-14 pb-12 md:pt-20">
      <h1 class="ru-display ru-h1">Contacter RESTUP</h1>
      <p class="ru-lead mt-5">
        Une question sur le groupe, une expertise ou un partenariat ? Indiquez le sujet de votre message et les
        coordonnées auxquelles vous joindre.
      </p>
      <p class="mt-4">
        <a href="/diagnostic" class="ru-link">Pour un besoin d’accompagnement, demandez un diagnostic.</a>
      </p>
    </div>
  </section>
  <section class="ru-section ru-light">
    <div class="ru-container max-w-3xl">
      <LeadForm type="contact" />
    </div>
  </section>
</Layout>
