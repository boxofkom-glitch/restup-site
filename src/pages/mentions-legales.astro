---
import Layout from '~/layouts/PageLayout.astro';
import F from '~/components/restup/LegalField.astro';
import { LEGAL } from '~/data/site';

const metadata = {
  title: 'Mentions légales · RESTUP',
  ignoreTitleTemplate: true,
  description: 'Informations sur l’éditeur et l’hébergeur du site RESTUP.',
  robots: { index: false, follow: true },
};

const editorRows = [
  ['Éditeur', LEGAL.editorName],
  ['Statut', LEGAL.legalForm],
  ['Adresse', LEGAL.address],
  ['Immatriculation', LEGAL.registration],
  ...(LEGAL.vatNumber ? [['TVA intracommunautaire', LEGAL.vatNumber]] : []),
  ['Directeur de la publication', LEGAL.publicationDirector],
  ['E-mail', LEGAL.contactEmail],
  ['Téléphone', LEGAL.phone],
];
const hostRows = [
  ['Hébergeur', LEGAL.host.name],
  ['Adresse', LEGAL.host.address],
  ['Contact', LEGAL.host.contact],
];
---

<Layout metadata={metadata}>
  <section class="ru-section ru-light">
    <div class="ru-container max-w-3xl ru-prose space-y-8">
      <h1 class="ru-display ru-h1">Mentions légales</h1>
      <section>
        <h2 class="ru-h3">Éditeur du site</h2>
        <dl class="mt-3 space-y-2">
          {
            editorRows.map(([label, value]) => (
              <div>
                <dt class="inline font-bold">{label} : </dt>
                <dd class="inline">
                  <F value={value} />
                </dd>
              </div>
            ))
          }
        </dl>
      </section>
      <section>
        <h2 class="ru-h3">Hébergeur</h2>
        <dl class="mt-3 space-y-2">
          {
            hostRows.map(([label, value]) => (
              <div>
                <dt class="inline font-bold">{label} : </dt>
                <dd class="inline">
                  <F value={value} />
                </dd>
              </div>
            ))
          }
        </dl>
      </section>
      <section>
        <h2 class="ru-h3">Propriété intellectuelle</h2>
        <p class="mt-3">
          La marque RESTUP, son logo et les contenus du site ne peuvent être reproduits sans autorisation.
        </p>
      </section>
    </div>
  </section>
</Layout>
