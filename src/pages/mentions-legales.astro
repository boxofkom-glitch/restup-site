---
import Layout from '~/layouts/PageLayout.astro';
import F from '~/components/restup/LegalField.astro';
import { LEGAL } from '~/data/site';

const metadata = {
  title: 'Mentions légales · RESTUP',
  ignoreTitleTemplate: true,
  description: 'Informations sur l’éditeur et l’hébergeur du site RESTUP.',
  robots: { index: false, follow: true },
};
---

<Layout metadata={metadata}>
  <section class="ru-section ru-light">
    <div class="ru-container max-w-3xl ru-prose space-y-8">
      <h1 class="ru-display ru-h1">Mentions légales</h1>
      <section>
        <h2 class="ru-h3">Éditeur du site</h2>
        <dl class="mt-3 space-y-2">
          <div>
            <dt class="inline font-bold">Raison sociale :</dt><dd class="inline"><F value={LEGAL.editorName} /></dd>
          </div>
          <div>
            <dt class="inline font-bold">Forme juridique et capital :</dt><dd class="inline">
              <F value={LEGAL.legalForm} />
            </dd>
          </div>
          <div><dt class="inline font-bold">Adresse :</dt><dd class="inline"><F value={LEGAL.address} /></dd></div>
          <div>
            <dt class="inline font-bold">Immatriculation :</dt><dd class="inline"><F value={LEGAL.registration} /></dd>
          </div>
          {
            LEGAL.vatNumber && (
              <div>
                <>
                  <dt class="inline font-bold">TVA intracommunautaire : </dt>
                  <dd class="inline">{LEGAL.vatNumber}</dd>
                </>
              </div>
            )
          }
          <div>
            <dt class="inline font-bold">Directeur de la publication :</dt><dd class="inline">
              <F value={LEGAL.publicationDirector} />
            </dd>
          </div>
          <div><dt class="inline font-bold">Contact :</dt><dd class="inline"><F value={LEGAL.contactEmail} /></dd></div>
        </dl>
      </section>
      <section>
        <h2 class="ru-h3">Hébergeur</h2>
        <dl class="mt-3 space-y-2">
          <div><dt class="inline font-bold">Nom :</dt><dd class="inline"><F value={LEGAL.host.name} /></dd></div>
          <div><dt class="inline font-bold">Adresse :</dt><dd class="inline"><F value={LEGAL.host.address} /></dd></div>
          <div><dt class="inline font-bold">Contact :</dt><dd class="inline"><F value={LEGAL.host.contact} /></dd></div>
        </dl>
      </section>
      <section>
        <h2 class="ru-h3">Propriété intellectuelle</h2>
        <p class="mt-3">
          La marque RESTUP, son logo et les contenus du site ne peuvent être reproduits sans autorisation.
        </p>
      </section>
    </div>
  </section>
</Layout>
