---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Page introuvable · RESTUP',
  ignoreTitleTemplate: true,
  robots: { index: false, follow: true },
};
---

<Layout metadata={metadata}>
  <section class="ru-corners ru-dark">
    <div class="ru-container py-24 md:py-32 max-w-3xl">
      <h1 class="ru-display ru-h1">Cette page est introuvable</h1>
      <p class="ru-lead mt-5">
        L’adresse a peut-être changé. Retrouvez nos services dans le répertoire des expertises.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a href="/expertises" class="ru-btn ru-btn-primary">Explorer les expertises</a>
        <a href="/" class="ru-btn ru-btn-ghost">Revenir à l’accueil</a>
      </div>
    </div>
  </section>
</Layout>
