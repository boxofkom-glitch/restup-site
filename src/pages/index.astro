---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import Faq from '~/components/restup/Faq.astro';
import CtaBlock from '~/components/restup/CtaBlock.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE } from 'astrowind:config';
import { DOMAINS, DIVISION_LABELS, SIGNATURE } from '~/data/site';
import { divisionBySlug } from '~/lib/catalogue';
import ambiance from '~/assets/images/brand/illustration.jpg';
import logo from '~/assets/images/brand/logo-restup.png';

const metadata = {
  title: 'Accompagnement des restaurateurs en France · RESTUP',
  ignoreTitleTemplate: true,
  description:
    'RESTUP réunit des expertises pour piloter votre restaurant, préparer une ouverture et structurer votre développement. Présentez votre projet.',
};

// Organisation limitée aux faits connus : nom, site, logo et signature.
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE?.site}/#organization`,
    name: 'RESTUP',
    url: SITE?.site,
    logo: new URL(logo.src, SITE?.site).toString(),
    slogan: SIGNATURE,
  },
];

const steps = [
  {
    title: 'Votre situation',
    text: 'Décrivez votre établissement, vos contraintes et la décision que vous devez prendre.',
  },
  { title: 'Vos priorités', text: 'Nous définissons avec vous le périmètre de travail et les éléments à examiner.' },
  {
    title: 'Votre plan d’action',
    text: 'À l’issue de la mission, vous disposez des livrables convenus pour décider de la suite.',
  },
];

const faq = [
  {
    q: 'Puis-je vous contacter avant l’ouverture ?',
    a: 'Oui. Précisez si votre concept, votre local ou votre date d’ouverture sont déjà définis.',
  },
  {
    q: 'Et si plusieurs sujets se croisent ?',
    a: 'Décrivez votre situation. Nous examinerons quel sujet traiter en premier et quelles expertises mobiliser.',
  },
  {
    q: 'Faut-il transmettre mes chiffres dès le premier message ?',
    a: 'Indiquez votre objectif et le stade de votre projet. Les documents utiles seront précisés si une mission se dessine.',
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Héros : texte à gauche, ambiance à droite ; sur mobile le texte passe avant l'image -->
  <section class="ru-corners ru-dark">
    <div class="ru-glow -left-1/4 top-0" aria-hidden="true"></div>
    <div
      class="ru-container grid lg:grid-cols-[1.15fr_0.85fr] gap-10 lg:gap-12 items-center pt-16 pb-14 md:pt-24 md:pb-20"
    >
      <div>
        <h1 class="ru-display ru-h1">
          Le partenaire des restaurateurs qui passent au <span class="ru-band">niveau supérieur.</span>
        </h1>
        <p class="ru-signature mt-7">{SIGNATURE}</p>
        <p class="ru-lead mt-6">
          Rentabilité, organisation, équipe, concept, visibilité et développement. Retrouvez les expertises RESTUP pour
          structurer votre projet et définir vos prochaines actions.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href="/diagnostic" class="ru-btn ru-btn-primary">Demander un diagnostic</a>
          <a href="/expertises" class="ru-btn ru-btn-ghost">Découvrir les expertises</a>
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-[460px] lg:max-w-none">
        <div class="relative overflow-hidden rounded-[20px] border border-white/15 aspect-[4/5]">
          <Image
            src={ambiance}
            alt=""
            widths={[400, 640, 920]}
            sizes="(min-width: 1024px) 40vw, 90vw"
            class="absolute inset-0 w-full h-full object-cover object-[50%_45%]"
            loading="eager"
            fetchpriority="high"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-[var(--ru-brand-900)] via-transparent to-[rgb(43_7_70/0.35)]"
            aria-hidden="true"
          >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Les six domaines -->
  <section class="ru-section ru-deep" aria-labelledby="domaines">
    <div class="ru-container">
      <p class="ru-eyebrow">Nos domaines</p>
      <h2 id="domaines" class="ru-display ru-h2 mt-3">Quel sujet voulez-vous traiter en premier ?</h2>
      <ul class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-6 gap-4">
        {
          DOMAINS.map((dom) => (
            <li class="ru-card flex flex-col">
              <span class="ru-icon" aria-hidden="true">
                <Icon name={dom.icon} class="w-7 h-7" />
              </span>
              <h3 class="ru-h3 mt-4 text-white">{dom.title}</h3>
              <p class="mt-2 ru-soft flex-1">{dom.text}</p>
              <ul class="mt-4 flex flex-wrap gap-2" aria-label={`Divisions pour ${dom.title}`}>
                {dom.divisions.map((slug) => {
                  const d = divisionBySlug(slug)!;
                  return (
                    <li>
                      <a
                        href={d.path}
                        class="inline-block rounded-lg border border-white/25 px-2.5 py-1.5 text-sm font-semibold hover:border-[var(--ru-yellow)] hover:text-[var(--ru-yellow)]"
                      >
                        {DIVISION_LABELS[d.slug].label}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Méthode -->
  <section class="ru-section ru-dark" aria-labelledby="methode">
    <div class="ru-container">
      <p class="ru-eyebrow">Méthode</p>
      <h2 id="methode" class="ru-display ru-h2 mt-3">Comment se déroule l’accompagnement ?</h2>
      <ol class="mt-10 grid md:grid-cols-3 gap-4">
        {
          steps.map((s, i) => (
            <li class="ru-card">
              <span class="font-black italic text-4xl text-[var(--ru-yellow)]" aria-hidden="true">
                0{i + 1}
              </span>
              <h3 class="ru-h3 mt-3 text-white">{s.title}</h3>
              <p class="mt-2 ru-soft">{s.text}</p>
            </li>
          ))
        }
      </ol>
      <a href="/offres" class="ru-link mt-8 inline-block">Voir les formats d’intervention</a>
    </div>
  </section>

  <Faq items={faq} />

  <CtaBlock
    title="Parlez-nous de votre établissement"
    text="Dites-nous où vous en êtes et quelle décision vous souhaitez prendre."
    cta="Demander un diagnostic"
    href="/diagnostic"
  />
</Layout>
