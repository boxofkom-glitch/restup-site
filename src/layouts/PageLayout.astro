---
import Layout from '~/layouts/Layout.astro';
import SiteHeader from '~/components/restup/SiteHeader.astro';
import SiteFooter from '~/components/restup/SiteFooter.astro';
import { Icon } from 'astro-icon/components';

const whatsapp = import.meta.env.PUBLIC_WHATSAPP_NUMBER;

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
---

<Layout metadata={metadata}>
  <slot name="head" slot="head" />
  {
    /*
    Slot fallbacks are rendered explicitly. With `<slot name="x">fallback</slot>`
    Astro still evaluates the fallback when the page overrides the slot, and
    astro-icon then believes the icons inside it (the RSS icon of the default
    header, for instance) were already emitted, so their SVG sprite symbol
    goes missing on that page.
  */
  }
  {Astro.slots.has('announcement') && <slot name="announcement" />}
  {Astro.slots.has('header') ? <slot name="header" /> : <SiteHeader />}
  <main id="contenu" class="flex-1">
    <slot />
  </main>
  {Astro.slots.has('footer') ? <slot name="footer" /> : <SiteFooter />}
  {
    whatsapp && (
      <a
        href={`https://wa.me/${whatsapp}`}
        class="fixed bottom-5 right-5 z-50 grid place-items-center w-14 h-14 rounded-full bg-[#25d366] text-white shadow-xl hover:scale-105 transition"
        aria-label="Nous écrire sur WhatsApp"
      >
        <Icon name="tabler:brand-whatsapp" class="w-8 h-8" aria-hidden="true" />
      </a>
    )
  }
</Layout>
